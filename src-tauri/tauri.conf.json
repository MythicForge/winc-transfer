{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WINCI",
  "version": "0.11.2",
  "identifier": "com.winc.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "trunk serve --config ui/Trunk.toml",
    "beforeBuildCommand": "trunk build --release --config ui/Trunk.toml"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WINCI — Data Crossing",
        "width": 1060,
        "height": 780,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {}
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
